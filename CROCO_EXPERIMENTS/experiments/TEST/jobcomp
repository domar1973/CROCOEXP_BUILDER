#!/bin/bash
####################################################
#               COMPILATION JOB                    #
####################################################
#
# MODIFICADO PARA CROCO_EXPERIMENTS
#
# This script assumes default compilation options, to
# change those options : 
# it can either 
# 1. be  edited to add your own options
# 2. take environment variables
# 3. take argument variables
#
# CROCO_SRC : sources for CROCO
#
# CROCO_NETCDFLIB      : netcdf library
# CROCO_NETCDFINC      : netcdf include 
# CROCO_PRISM_ROOT_DIR : OASIS-MCT directory 
# CROCO_XIOS_ROOT_DIR  : XIOS directory
#
# CROCO_CFT1           : compiler
# CROCO_FFLAGS1        : compilation options
# NPROCS               : number of process at compilation
#
# Note that environment or commande line
# variables overwrite hard-coded options
#

#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------
# Identidad del experimento (por ubicación del script)
# ---------------------------------------------------------
EXP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Layout README
BUILD_DIR="${EXP_DIR}/build"
LOG_DIR="${EXP_DIR}/LOG"
mkdir -p "${BUILD_DIR}" "${LOG_DIR}"

LOGFILE="${LOG_DIR}/jobcomp_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "${LOGFILE}") 2>&1

echo
echo "== CROCO jobcomp (experiment) =="
echo "EXP_DIR   : ${EXP_DIR}"
echo "BUILD_DIR : ${BUILD_DIR}"
echo "LOGFILE   : ${LOGFILE}"
echo

# ---------------------------------------------------------
# Entorno CROCO desde MSOT root (setup.sh)
# ---------------------------------------------------------
if [[ -z "${CROCOEXP_HOME:-}" || -z "${version:-}" ]]; then
  echo "ERROR: faltan CROCOEXP_HOME y/o version."
  echo "Sugerencia: desde /opt/MSOT ejecutar: source setup.sh"
  exit 1
fi

SOURCE1="${CROCOEXP_HOME}/${version}/OCEAN"
if [[ ! -d "${SOURCE1}" ]]; then
  echo "ERROR: no encuentro CROCO OCEAN en: ${SOURCE1}"
  exit 1
fi

# ---------------------------------------------------------
# Directorios de compilación y run (en build/)
# ---------------------------------------------------------
SCRDIR="${BUILD_DIR}/Compile"
RUNDIR="${BUILD_DIR}"

rm -rf "${SCRDIR}"
mkdir -p "${SCRDIR}"

echo "SOURCE1 : ${SOURCE1}"
echo "SCRDIR  : ${SCRDIR}"
echo "RUNDIR  : ${RUNDIR}"
echo

# ---------------------------------------------------------
# Copiar fuente CROCO base -> SCRDIR (sin tocar distro)
# ---------------------------------------------------------
echo "Copiando fuentes base CROCO..."
cp -f "${SOURCE1}/"*.F* "${SCRDIR}/"
cp -f "${SOURCE1}/"*.h* "${SCRDIR}/" 2>/dev/null || true
cp -f "${SOURCE1}/Make"* "${SCRDIR}/" 2>/dev/null || true

# ---------------------------------------------------------
# Overwrite con archivos del experimento
# layout preferido: headers/ src/ make/
# fallback: root del experimento
# ---------------------------------------------------------
copy_glob_if_exists () {
  local pattern="$1"
  local dest="$2"
  shopt -s nullglob
  local files=( $pattern )
  shopt -u nullglob
  if (( ${#files[@]} )); then
    echo "  overwrite: ${pattern}"
    cp -f ${files[@]} "$dest"
  fi
}

echo "Aplicando overrides del experimento (si existen)..."

# Nuevo layout (preferido)
copy_glob_if_exists "${EXP_DIR}/src/"*.F90  "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/src/"*.F    "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/headers/"*.h   "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/headers/"*.h90 "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/make/Make"*     "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/make/Makedefs"* "${SCRDIR}"

# Fallback (layout viejo)
copy_glob_if_exists "${EXP_DIR}/"*.F90 "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/"*.F   "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/"*.h   "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/"*.h90 "${SCRDIR}"
copy_glob_if_exists "${EXP_DIR}/Make"* "${SCRDIR}"

echo
echo "Overrides aplicados. Compilando..."
echo

# ---------------------------------------------------------
# Compilar (usa Makefile copiado a SCRDIR)
# Nota: aquí no impongo CC/FC/NETCDF; se espera que el contenedor o tu entorno ya los tenga.
# ---------------------------------------------------------
cd "${SCRDIR}"

# Si el Makefile requiere variables, se usan desde el ambiente.
# En el contenedor base, normalmente ya están las toolchains.
make clean || true
make -j "${NPROCS:-1}"

# ---------------------------------------------------------
# Depositar ejecutables en build/
# (ajustá nombres si tu Makefile produce otros binarios)
# ---------------------------------------------------------
cd "${SCRDIR}"
if [[ -f croco ]]; then
  cp -f croco "${RUNDIR}/"
  echo "OK: ejecutable -> ${RUNDIR}/croco"
else
  echo "WARN: no encontré 'croco' en ${SCRDIR}. Revisar salida de make."
fi

echo
echo "Compilación terminada."
echo "Build: ${BUILD_DIR}"
echo "Log  : ${LOGFILE}"
echo
