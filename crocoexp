#!/usr/bin/env python3
import argparse
import sys

from crocoexp_lib import cmd_compile, cmd_dry_run, cmd_import, cmd_inspect, cmd_run, cmd_setup, cmd_source_install, cmd_source_inspect, cmd_source_list


def build_parser():
    parser = argparse.ArgumentParser(
        prog="crocoexp",
        description="Host-side CROCO experiment builder commands.",
    )
    parser.add_argument(
        "--experiments-root",
        default="CROCO_EXPERIMENTS",
        help="Path to the CROCO_EXPERIMENTS directory.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    setup_p = sub.add_parser("setup", help="Prepare repo-level Docker backend readiness.")
    setup_p.add_argument("--image", help="Docker image to register as the repo default.")
    pull_group = setup_p.add_mutually_exclusive_group()
    pull_group.add_argument("--pull", action="store_true", help="Pull the selected image if missing.")
    pull_group.add_argument("--no-pull", action="store_true", help="Do not pull; fail if the selected image is missing.")
    setup_p.add_argument("--check-only", action="store_true", help="Check and report backend status.")
    setup_p.add_argument("--force", action="store_true", help="Overwrite existing setup state cleanly.")
    setup_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    source_p = sub.add_parser("source", help="Manage registered compile sources.")
    source_sub = source_p.add_subparsers(dest="source_command", required=True)
    source_install_p = source_sub.add_parser("install", help="Copy and register a compile source tree.")
    source_install_p.add_argument("path", help="Host path to the source tree to install.")
    source_install_p.add_argument("--id", required=True, dest="source_id", help="Registered source id.")
    source_install_p.add_argument("--flavor", choices=("croco", "msot", "custom"), default="custom", help="Source flavor for traceability.")
    source_install_p.add_argument("--version", dest="declared_version", help="Declared source version or tag.")
    source_install_p.add_argument("--notes", default="", help="Human-readable source notes.")
    source_install_p.add_argument("--force", action="store_true", help="Replace an existing registered source with the same id.")
    source_install_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    source_list_p = source_sub.add_parser("list", help="List registered compile sources.")
    source_list_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    source_inspect_p = source_sub.add_parser("inspect", help="Inspect one registered compile source.")
    source_inspect_p.add_argument("source_id")
    source_inspect_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    import_p = sub.add_parser("import", help="Register and analyze an experiment input/ folder.")
    import_p.add_argument("experiment_name")
    import_p.add_argument("--source", dest="source_id", help="Registered compile source id for this experiment.")
    import_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    inspect_p = sub.add_parser("inspect", help="Show manifest summary.")
    inspect_p.add_argument("experiment_name")
    inspect_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    compile_p = sub.add_parser("compile", help="Attempt CROCO compilation through Docker.")
    compile_p.add_argument("experiment_name")
    compile_p.add_argument(
        "--image",
        help="Docker image used as the CROCO execution backend.",
    )
    compile_p.add_argument("--source", dest="source_id", help="Registered compile source id for this compile attempt.")
    compile_p.add_argument("--jobs", default="1", help="Compilation parallelism passed to jobcomp.")
    compile_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    dry_run_p = sub.add_parser("dry-run", help="Produce a traceable pre-execution report.")
    dry_run_p.add_argument("experiment_name")
    dry_run_p.add_argument("--run-id", help="Run id used for report and snapshot paths.")
    dry_run_p.add_argument("--image", help="Docker image used for backend readiness checks.")
    dry_run_p.add_argument("--no-docker", action="store_true", help="Skip Docker-backed readiness checks.")
    dry_run_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    run_p = sub.add_parser("run", help="Attempt CROCO execution through Docker.")
    run_p.add_argument("experiment_name")
    run_p.add_argument("--run-id", help="Run id used for logs, output, reports, and snapshots.")
    run_p.add_argument("--image", help="Docker image used for execution.")
    run_p.add_argument("--require-dry-run", action="store_true", help="Require an existing dry-run report for this run id.")
    run_p.add_argument("--json", action="store_true", help="Print machine-readable summary.")

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "setup":
        return cmd_setup(args)
    if args.command == "source":
        if args.source_command == "install":
            return cmd_source_install(args)
        if args.source_command == "list":
            return cmd_source_list(args)
        if args.source_command == "inspect":
            return cmd_source_inspect(args)
    if args.command == "import":
        return cmd_import(args)
    if args.command == "inspect":
        return cmd_inspect(args)
    if args.command == "compile":
        return cmd_compile(args)
    if args.command == "dry-run":
        return cmd_dry_run(args)
    if args.command == "run":
        return cmd_run(args)
    parser.error(f"unknown command {args.command}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
